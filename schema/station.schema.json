{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Musa-Go/Macmini-station/schema/station.schema.json",
  "title": "Macmini-station configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "machine",
    "storage",
    "remoteAccess",
    "notifications",
    "agent",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "profile"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "id of a file in profiles/"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup"
      ],
      "properties": {
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "target",
            "schedule",
            "retention"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "local",
                    "external-disk",
                    "smb-restic",
                    "s3-restic"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "description": "required for smb-restic"
                },
                "share": {
                  "type": "string",
                  "description": "required for smb-restic"
                }
              }
            },
            "schedule": {
              "type": "string",
              "pattern": "^\\s*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s*$"
            },
            "include": {
              "type": "array",
              "description": "paths (absolute, or relative to the station directory) to snapshot; defaults to ['.station', 'station.json']",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "daily",
                "weekly",
                "monthly"
              ],
              "properties": {
                "daily": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "weekly": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 52
                },
                "monthly": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                }
              }
            }
          }
        }
      }
    },
    "remoteAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "tailscale"
          ]
        },
        "ports": {
          "type": "array",
          "description": "ports to publish on the tailnet when enabled",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "ports"
            ],
            "properties": {
              "ports": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "enum": [
            "none",
            "qq",
            "bark"
          ]
        },
        "fallback": {
          "enum": [
            "none",
            "qq",
            "bark"
          ]
        },
        "qq": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appId": {
              "type": "string",
              "minLength": 1
            },
            "secretRef": {
              "type": "string",
              "minLength": 1,
              "description": "keychain entry name, never the secret itself"
            },
            "allowFrom": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "description": "explicit recipient openid; defaults to the first allowFrom entry"
            }
          }
        },
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "string",
              "minLength": 1,
              "description": "keychain entry name, never the secret itself"
            }
          }
        },
        "inbound": {
          "type": "object",
          "additionalProperties": false,
          "description": "QQ inbound command listener (`station serve`); strictly read-only commands",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "defaults to false"
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "workingDirectory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workingDirectory": {
          "type": "string"
        },
        "tasks": {
          "type": "object",
          "description": "named argv arrays that `station worktree run` is allowed to execute; no shell is involved",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "taskTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "per-task timeout, default 600"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "argv template executed by `worktree agent`; supports {prompt} and {worktree}"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "description": "test gate that must pass before commit/push",
          "properties": {
            "task": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean",
              "description": "defaults to true"
            }
          }
        },
        "isolation": {
          "enum": [
            "none",
            "dedicated-user"
          ],
          "description": "\"dedicated-user\" declares that agent commands are run under a separate macOS account (see docs/ISOLATION.md)"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
